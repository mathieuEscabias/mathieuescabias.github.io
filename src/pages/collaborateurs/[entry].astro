---
import type { collaborateursEntry, DocsEntry } from "@/types";
import EntryLayout from "@components/collaborateurs/EntryLayout.astro";
import { slugify } from "@lib/textConverter";
import { getEntries } from "@lib/contentParser";
import { sortByDate } from "@lib/sortFunctions";

export async function getStaticPaths() {
  const entries = (await getEntries("collaborateurs")) as collaborateursEntry[];
  const paths = entries.map((entry) => ({
    params: {
      entry: entry.id,
    },
    props: { entry },
  }));
  return paths;
}

const { entry } = Astro.props;
const { title } = entry.data;
const docsEntries = (await getEntries("docs", sortByDate)) as DocsEntry[];
const filteredDocsEntries = docsEntries.filter((docEntry: DocsEntry) =>
  docEntry.data.author?.some((author) => slugify(author.id) === slugify(entry.id))
);
---

<EntryLayout entry={entry} recentBlogEntries={filteredDocsEntries} />
