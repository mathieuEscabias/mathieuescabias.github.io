<script is:inline>
  const STORAGE_KEY = "theme";
  const DEFAULT_THEME = "dark";

  function getDarkMode() {
    let stored = null;
    try { stored = localStorage.getItem(STORAGE_KEY); } catch (e) {}
    if (stored === "light") return false;
    if (stored === "dark") return true;
    if (stored === "system") return matchMedia("(prefers-color-scheme: dark)").matches;
    return DEFAULT_THEME === "dark"; // rien de stocké → dark par défaut
  }

  function applyTheme(dark, root = document.documentElement) {
    root.classList.toggle("dark", dark);
  }

  // 1er chargement (avant le rendu, pas de flash)
  applyTheme(getDarkMode());

  // Navigation View Transitions : on applique le thème au nouveau document AVANT le swap
  document.addEventListener("astro:before-swap", (e) => {
    applyTheme(getDarkMode(), e.newDocument.documentElement);
  });

  // Switch : on ne sauvegarde que sur un clic de l'utilisateur
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll("[data-theme-switcher]").forEach((el) => {
      el.checked = document.documentElement.classList.contains("dark");
      el.addEventListener("change", (e) => {
        const dark = e.target.checked;
        applyTheme(dark);
        try { localStorage.setItem(STORAGE_KEY, dark ? "dark" : "light"); } catch (err) {}
      });
    });
  });
</script>
